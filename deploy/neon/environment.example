# Copy to .env.neon at the repository root. Never commit the filled file.
APP_HOST=cabinet.example.com
TLS_EMAIL=admin@example.com

# Direct endpoint and Neon owner role: migration container only.
DATABASE_URL_ADMIN=postgresql://neondb_owner:replace-me@ep-example.region.aws.neon.tech/neondb?sslmode=require
# Pooled endpoint and restricted cabinet_app role: web container only.
DATABASE_URL=postgresql://cabinet_app:replace-me@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Pooled endpoint and restricted cabinet_sync role: sync routes only.
SYNC_DATABASE_URL=postgresql://cabinet_sync:replace-me@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_MAX=5

MFA_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
AUTH_RATE_LIMIT_SECRET=replace-with-at-least-32-random-bytes
REGISTRATION_MODE=first-only
TZ=Africa/Algiers

# Optional staff password-reset email. Empty SMTP_HOST disables email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
