# Runtime connection: restricted role, RLS enforced.
DATABASE_URL=postgres://cabinet_app:cabinet_app_dev@localhost:54329/cabinet
# Maximum connections opened by one web process (use 5 with a Neon pooled URL).
DATABASE_POOL_MAX=10
# Migrations / seed: schema owner.
DATABASE_URL_ADMIN=postgres://cabinet_owner:cabinet_owner_dev@localhost:54329/cabinet
# Integration tests use a separate database.
TEST_DATABASE_URL=postgres://cabinet_app:cabinet_app_dev@localhost:54329/cabinet_test
TEST_DATABASE_URL_ADMIN=postgres://cabinet_owner:cabinet_owner_dev@localhost:54329/cabinet_test
# Public base URL used in links (booking links, consent requests).
APP_URL=http://localhost:3000
# Optional internet address of this installation, used for the public clinic page links and QR posters.
# Leave empty when the server is only reachable on the clinic network.
PUBLIC_APP_URL=
# Optional outgoing email (staff "forgot password" links only). Leave SMTP_HOST empty to disable.
# Port 465 uses TLS directly; other ports upgrade with STARTTLS. Links use PUBLIC_APP_URL, else APP_URL.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Dedicated high-entropy key used to protect staff TOTP secrets at rest.
MFA_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
# HMAC key for privacy-preserving per-IP authentication throttles.
AUTH_RATE_LIMIT_SECRET=replace-with-at-least-32-random-bytes

# Durable local/object-mounted directory for private clinical uploads.
CLINICAL_STORAGE_DIR=.data/clinical-files
# `first-only` is safest for one clinic; use `open` only for a deliberate multi-clinic service.
REGISTRATION_MODE=first-only

# Demo seed (development only)
SEED_DEMO_EMAIL=demo.owner@cabinet.test
SEED_DEMO_PASSWORD=demo-cabinet-2026
